# ---- core ----
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001
APP_DEEP_LINK_SCHEME=tsp

DATABASE_URL=postgresql://tsp:tsp@localhost:5432/tsp?schema=public
REDIS_URL=redis://localhost:6379

# ---- auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- risk disclaimer ----
# Bump this string to force every user to re-accept the disclaimer.
RISK_DISCLAIMER_VERSION=2026-01

# ---- media storage (S3 / Cloudflare R2 / MinIO) ----
# Left empty on purpose: with no credentials StorageService writes to ./uploads
# on local disk and the API serves it, so image upload works on a fresh clone
# with nothing else running. Filling these in switches to the object store —
# and then the endpoint must actually be reachable, because a configured S3 is
# treated as intentional and a failure is surfaced rather than silently
# falling back.
#
# For MinIO (docker compose -f infra/docker-compose.yml up -d):
#   S3_ENDPOINT=http://localhost:9000
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#   S3_PUBLIC_BASE_URL=http://localhost:9000/tsp-media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=tsp-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# ---- video (Cloudflare Stream) ----
# Course video is the entire value of the NORMAL plan, so playback is served
# through short-lived signed tokens and the raw UID is never sent to a client.
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
CF_STREAM_TOKEN_TTL_SEC=7200

# ---- payments (external by default) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=tsp://checkout/success
STRIPE_CANCEL_URL=tsp://checkout/cancel

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

BANK_TRANSFER_INSTRUCTIONS="Contact support for bank transfer details."

# In-app purchase is implemented but inert until a plan's paymentMode allows
# it. Fill these only if App Review requires IAP for the recorded-video plan.
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ---- live coaching (Daily.co) ----
DAILY_API_KEY=
DAILY_DOMAIN=

# ---- telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=true

# ---- push ----
EXPO_ACCESS_TOKEN=

# ---- MT5 bridge ----
# Created via the admin panel; the EA sends it as X-Ingest-Key.
INGEST_KEY_BOOTSTRAP=

# ---- seeding ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
